{
  "name": "host_trailing_dot_deny",
  "ruleset": {
    "deny_always": [
      {"host": "api.example.com", "mode": "intercept", "reason": "Blocked."}
    ]
  },
  "request": {"host": "api.example.com.", "path": "/x", "method": "GET"},
  "expected": {"decision": "hard-deny", "mode": "intercept", "matched_rule": {"list": "deny_always", "index": 0}}
}
