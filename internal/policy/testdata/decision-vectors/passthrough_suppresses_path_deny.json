{
  "name": "passthrough_suppresses_path_deny",
  "ruleset": {
    "allow": [
      {"host": "api.anthropic.com", "mode": "passthrough"}
    ],
    "deny_always": [
      {"host": "*", "paths": ["**/.env"], "mode": "intercept", "reason": "Secrets path."}
    ]
  },
  "request": {"host": "api.anthropic.com", "path": "/v1/.env", "method": "POST"},
  "expected": {"decision": "allow", "mode": "passthrough", "matched_rule": {"list": "allow", "index": 0}}
}
