[
  {
    "rule": {
      "host": "laravel.com"
    },
    "source": "generated:composer_json:laravel/framework"
  },
  {
    "rule": {
      "host": "github.com",
      "paths": [
        "/laravel/framework/"
      ]
    },
    "source": "generated:composer_json:laravel/framework"
  },
  {
    "rule": {
      "host": "raw.githubusercontent.com",
      "paths": [
        "/laravel/framework/"
      ]
    },
    "source": "generated:composer_json:laravel/framework"
  },
  {
    "rule": {
      "host": "codeload.github.com",
      "paths": [
        "/laravel/framework/"
      ]
    },
    "source": "generated:composer_json:laravel/framework"
  },
  {
    "rule": {
      "host": "laravel.github.io",
      "paths": [
        "/framework/"
      ]
    },
    "source": "generated:composer_json:laravel/framework"
  },
  {
    "rule": {
      "host": "objects.githubusercontent.com"
    },
    "source": "generated:composer_json:laravel/framework",
    "lower_trust": true
  },
  {
    "rule": {
      "host": "github.com",
      "paths": [
