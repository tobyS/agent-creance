{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "vendor/fixture",
  "type": "project",
  "repositories": [
    {
      "type": "path",
      "url": "../packages/core",
      "options": { "symlink": true }
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-mbstring": "*",
    "ext-intl": "*",
    "ext-fileinfo": "*",
    "monolog/monolog": "^3.0",
    "laravel/framework": "^11.0",
    "acme/core": "@dev",
    "roave/security-advisories": "dev-master"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "laravel/pint": "1.13.0"
  },
  "autoload": {
    "psr-4": { "App\\": "app/" }
  },
  "scripts": {
    "post-update-cmd": ["@php artisan vendor:publish --tag=assets"]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": { "php-http/discovery": true }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
