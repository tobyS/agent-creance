# init scaffolds a .agent-creance.yaml, scanning for package.json / composer.json
# manifests (root + up to two directory levels deep, skipping installed-dependency
# dirs) and pre-populating generators: in object form. It refuses to clobber an
# existing config without --force.
#
# These scenarios use --no-setup so they stay hermetic: plain `init` now gates on
# the host-setup check, which reads the real login keychain (cli.Main wires
# OSKeychain → the absolute /usr/bin/security, not stubbable via $PATH). The
# keychain/terminal-dependent bootstrap paths (confirm, decline, already-set-up,
# non-interactive abort) are covered by init_test.go's *App+fakes unit tests
# instead. --no-setup skips the gate entirely, so the scaffold is pure filesystem
# work — PATH=$CREANCE_BIN is enough.
env PATH=$CREANCE_BIN

# --help advertises --force AND --no-setup, and rejects extra args before any side effect.
agent-creance init --help
stdout '--force'
stdout '--no-setup'
# Help is a doc surface: a Long: description and a worked Examples: section.
stdout 'one-time, per-project'
stdout 'Examples:'
stdout 'agent-creance init --git-push'
! agent-creance init bogus
stderr 'unknown command'

# 1. Empty dir → commented generators placeholder; re-run refuses; --force wins.
#    With --no-setup the success line still points at setup (host setup pending).
#    No .git → no git-remote block.
mkdir empty
cd empty
agent-creance init --no-setup
stdout 'no manifests detected'
stdout 'Next: run `agent-creance setup`'
! stdout 'Git remotes:'
exists .agent-creance.yaml
grep '# generators:' .agent-creance.yaml
! grep 'git-receive-pack' .agent-creance.yaml
! agent-creance init --no-setup
stderr 'already exists'
stderr '--force'
agent-creance init --no-setup --force
stdout 'Wrote .agent-creance.yaml'
cd ..

# 5. GitHub HTTPS remote, non-interactive → read-only by default: repo/API/content
#    allow entries plus a deny_always on git-receive-pack.
cd ghttps
agent-creance init --no-setup
stdout 'Git remotes: allowlisted 1 remote'
stdout 'read-only'
grep 'host: github.com' .agent-creance.yaml
grep 'host: api.github.com' .agent-creance.yaml
grep '/repos/foo/bar/' .agent-creance.yaml
grep 'deny_always:' .agent-creance.yaml
grep 'git-receive-pack' .agent-creance.yaml
cd ..

# 6. --git-push grants write: same allow entries, no deny_always push block.
cd ghpush
agent-creance init --no-setup --git-push
stdout 'push allowed'
grep 'host: github.com' .agent-creance.yaml
! grep 'git-receive-pack' .agent-creance.yaml
cd ..

# 7. SSH remote → HTTPS forge hosts still added, with the SSH-transport caveat.
cd sshremote
agent-creance init --no-setup
stdout 'non-HTTPS transport'
grep 'host: github.com' .agent-creance.yaml
grep 'host: api.github.com' .agent-creance.yaml
cd ..

# 8. Unknown/self-hosted forge → bare repo-host allow, no API/CDN companions.
cd selfhost
agent-creance init --no-setup
stdout 'not a known forge'
grep 'host: git.example.com' .agent-creance.yaml
! grep 'api.github.com' .agent-creance.yaml
cd ..

# 2. package.json only → package_json listed (object form), composer_json absent.
cd pkg
agent-creance init --no-setup
stdout 'package.json'
grep '- type: package_json' .agent-creance.yaml
grep 'path: package.json' .agent-creance.yaml
! grep 'composer_json' .agent-creance.yaml
cd ..

# 3. Both root manifests → both generators listed.
cd both
agent-creance init --no-setup
stdout 'package.json, composer.json'
grep 'type: package_json' .agent-creance.yaml
grep 'type: composer_json' .agent-creance.yaml
cd ..

# 4. Monorepo → sub-package manifest detected with its path; node_modules ignored.
cd mono
agent-creance init --no-setup
stdout 'apps/web/package.json'
grep 'path: package.json' .agent-creance.yaml
grep 'path: apps/web/package.json' .agent-creance.yaml
! grep 'node_modules' .agent-creance.yaml
cd ..

-- pkg/package.json --
{"dependencies": {"react": "^18.0.0"}}
-- both/package.json --
{}
-- both/composer.json --
{"require": {"monolog/monolog": "^3.0"}}
-- mono/package.json --
{}
-- mono/apps/web/package.json --
{"dependencies": {"react": "^18.0.0"}}
-- mono/node_modules/react/package.json --
{"name": "react"}
-- ghttps/.git/config --
[remote "origin"]
url = https://github.com/foo/bar.git
-- ghpush/.git/config --
[remote "origin"]
url = https://github.com/foo/bar.git
-- sshremote/.git/config --
[remote "origin"]
url = git@github.com:foo/bar.git
-- selfhost/.git/config --
[remote "origin"]
url = https://git.example.com/team/lib.git
