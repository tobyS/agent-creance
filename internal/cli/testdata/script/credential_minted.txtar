# `agent-creance credential add-github-app` / `add-oauth2` register minted
# credentials (AC-0069a): a github_app: / oauth2: sub-block instead of a static
# source. Like `add`, they only syntax-check references (no resolve, no minting), so
# the scenario runs offline. HOME/XDG_CACHE_HOME under $WORK keep it hermetic; PATH is
# pinned to $CREANCE_BIN so only the CLI is reachable.

env HOME=$WORK/home
env XDG_CACHE_HOME=$WORK/cache
env PATH=$CREANCE_BIN

# --help surfaces the minting model and worked examples.
agent-creance credential add-github-app --help
stdout 'app private key'
stdout '--repo'
stdout 'Examples:'
agent-creance credential add-oauth2 --help
stdout 'refresh token'
stdout 'drive.file'

# Validation: missing/invalid references and required flags are rejected before write.
! agent-creance credential add-github-app gh --client-id cid --repo o/n
stderr '--key is required'
! agent-creance credential add-github-app gh --key not-a-ref --client-id cid --repo o/n
stderr 'invalid --key'
! agent-creance credential add-github-app gh --key keychain://svc/k --repo o/n
stderr '--client-id is required'
! agent-creance credential add-github-app gh --key keychain://svc/k --client-id cid
stderr '--repo is required'
! agent-creance credential add-oauth2 d --client-id cid
stderr '--refresh-token is required'
! agent-creance credential add-oauth2 d --refresh-token not-a-ref --client-id cid
stderr 'invalid --refresh-token'

# add-github-app writes the github_app: sub-block with permissions, recompiles.
agent-creance credential add-github-app gh-app --key keychain://agent-creance/ghapp-key --client-id Iv1.example --repo tobyS/agent-creance --perm contents=read --perm issues=write
stdout 'added credential "gh-app"'
grep 'github_app:' .agent-creance.yaml
grep 'key: "keychain://agent-creance/ghapp-key"' .agent-creance.yaml
grep 'repo: "tobyS/agent-creance"' .agent-creance.yaml
grep 'permissions:' .agent-creance.yaml
grep 'contents: read' .agent-creance.yaml

# add-oauth2 writes the oauth2: sub-block; endpoint/scope stay implicit (Google Drive
# drive.file defaults are applied at parse time, per the config example).
agent-creance credential add-oauth2 drive --refresh-token keychain://agent-creance/drive-refresh --client-id 1234.apps.googleusercontent.com
stdout 'added credential "drive"'
grep 'oauth2:' .agent-creance.yaml
grep 'refresh_token: "keychain://agent-creance/drive-refresh"' .agent-creance.yaml
! grep 'token_endpoint' .agent-creance.yaml

# An explicit endpoint/scope is written verbatim.
agent-creance credential add-oauth2 custom --refresh-token op://Private/custom/rt --client-id abc --token-endpoint https://example.test/token --scope https://example.test/s
stdout 'added credential "custom"'
grep 'token_endpoint: "https://example.test/token"' .agent-creance.yaml
grep 'scopes:' .agent-creance.yaml

# list shows the kind and the relevant reference (never a value) for each form.
agent-creance credential list
stdout 'KIND'
stdout 'github-app'
stdout 'oauth2'
stdout 'keychain://agent-creance/ghapp-key'
stdout 'keychain://agent-creance/drive-refresh'

# A minted credential shaped for git-over-HTTPS uses Basic with x-access-token.
agent-creance credential add-github-app gh-git --key keychain://agent-creance/ghapp-key --client-id Iv1.example --repo tobyS/agent-creance --perm contents=read --basic --username x-access-token
stdout 'added credential "gh-git"'
grep 'username: x-access-token' .agent-creance.yaml

# --basic without --username is rejected.
! agent-creance credential add-github-app bad --key keychain://svc/k --client-id cid --repo o/n --basic
stderr '--basic needs --username'
