# `agent-creance credential add/list/remove` manage the credentials: block and
# recompile so a running proxy hot-reloads. add only syntax-checks --source (no
# resolve), so the whole scenario runs offline — no `op`, no network, no external
# tools. HOME/XDG_CACHE_HOME under $WORK keep it hermetic; PATH is pinned to
# $CREANCE_BIN so only the CLI is reachable (AC-0068d).

env HOME=$WORK/home
env XDG_CACHE_HOME=$WORK/cache
env PATH=$CREANCE_BIN

# --help is a doc surface: Long: description + worked Examples: section.
agent-creance credential --help
stdout 'caged agent authenticates without ever holding the secret'
agent-creance credential add --help
stdout '--source'
stdout '--bearer'
stdout 'resolved when'
stdout 'Examples:'
stdout 'agent-creance credential add github --source'

# Invalid flag combinations and a bad source are rejected before any write.
! agent-creance credential add x --source op://a/b --bearer --basic
stderr 'pick only one header shape'
! agent-creance credential add x --source not-a-ref --bearer
stderr 'want an op:// , keychain:// , or env:// reference'
! agent-creance credential add x --source op://a/b --basic
stderr '--basic needs --username'

# add --bearer → credentials: block synthesized (comment preserved), recompiled.
agent-creance credential add github --source op://Private/GitHub/token --bearer
stdout 'added credential "github" in \.agent-creance\.yaml'
grep '# keep this comment' .agent-creance.yaml
grep 'source: "op://Private/GitHub/token"' .agent-creance.yaml
grep 'template: "Bearer \{token\}"' .agent-creance.yaml

# A custom-header credential using the bare token in a named header.
agent-creance credential add anthropic --source op://Private/Anthropic/key --header x-api-key --raw
stdout 'added credential "anthropic"'
grep 'header: x-api-key' .agent-creance.yaml

# Re-adding the same name is a reported no-op.
agent-creance credential add github --source op://other/thing --bearer
stdout 'already added'

# list shows name/source/header/shape, never a value; both entries present.
agent-creance credential list
stdout 'NAME'
stdout 'github'
stdout 'op://Private/GitHub/token'
stdout 'Bearer \{token\}'
stdout 'anthropic'
stdout 'x-api-key'

# --global lands in ~/.config, not the project file.
agent-creance credential add teamwide --source op://Shared/token --bearer --global
stdout 'added credential "teamwide"'
exists $WORK/home/.config/agent-creance.yaml
grep 'teamwide' $WORK/home/.config/agent-creance.yaml
! grep 'teamwide' .agent-creance.yaml

# remove deletes the entry; removing an absent one is a clear non-zero error.
agent-creance credential remove github
stdout 'removed credential "github"'
! grep 'source: "op://Private/GitHub/token"' .agent-creance.yaml
! agent-creance credential rm github
stderr 'is not defined in .agent-creance.yaml; nothing to remove'

-- .agent-creance.yaml --
# keep this comment
network:
  egress:
    allow:
      - host: seed.example
