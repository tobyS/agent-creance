# Root --help is a real doc surface: a Long: orientation block with the
# setup -> init -> run happy path, and a grouped command list (Setup / Daily /
# Inspect / Maintenance) instead of one alphabetized wall. The auto-generated
# completion/help commands are routed into Maintenance, so no command falls
# under cobra's "Additional Commands:" bucket.
env PATH=$CREANCE_BIN

agent-creance --help
# Long: orientation — what it is plus the happy-path sequence.
stdout 'egress-filtered cage'
stdout 'setup -> init -> run'
stdout 'once per machine'
# Grouped command headings, in display order.
stdout 'Setup Commands:'
stdout 'Daily Commands:'
stdout 'Inspect Commands:'
stdout 'Maintenance Commands:'
# completion/help are grouped, not interleaved or dumped under Additional.
stdout 'completion'
! stdout 'Additional Commands:'

# -h is the same surface.
agent-creance -h
stdout 'Setup Commands:'
