# `agent-creance doctor` against a healthy host. We stub agent-safehouse and
# mitmproxy as tiny shell scripts on PATH that print the tested versions, so the
# whole scenario runs with no real prerequisites installed.

# Make the stubs executable and put them first on PATH. ${:} is testscript's
# OS-specific path-list separator.
chmod 0755 bin/agent-safehouse
chmod 0755 bin/mitmproxy
env PATH=$WORK/bin${:}$PATH

agent-creance doctor
stdout 'Version compatibility:'
stdout 'agent-safehouse'
stdout 'mitmproxy'
stdout '✓'
! stdout 'not installed'
# The full diagnostic appends its sections after the version block. These headers
# render deterministically regardless of host state; the findings under them
# degrade gracefully (no CA generated, no project proxy) so the command exits 0.
stdout 'CA trust:'
stdout 'Proxy \(this project\):'
stdout 'Exposed host services:'
stdout 'Filesystem reliability:'

-- bin/agent-safehouse --
#!/bin/sh
echo 'Agent Safehouse 0.10.1'
-- bin/mitmproxy --
#!/bin/sh
echo 'Mitmproxy: 12.2.3'
