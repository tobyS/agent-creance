# .agent-creance.yaml — agent-creance project config.
# Full schema and guidance: docs/design.md. Manage egress rules interactively
# with `agent-creance allow` / `agent-creance deny`.
agent:
  command: ["claude", "--dangerously-skip-permissions"]
  workdir: .

safehouse:
  add_dirs_rw: [.]

network:
  egress:
    generators:
      - type: package_json
        path: package.json
    allow:
      # Project git remotes — repo, API, and content hosts (agent-creance init)
      - host: github.com
        paths: ["/foo/bar/", "/foo/bar.git/"]
        reason: "project git remote (origin)"
      - host: api.github.com
        paths: ["/repos/foo/bar/"]
        reason: "project git remote (origin)"
      - host: raw.githubusercontent.com
        paths: ["/foo/bar/"]
        reason: "project git remote (origin)"
      - host: codeload.github.com
        paths: ["/foo/bar/"]
        reason: "project git remote (origin)"
      - host: foo.github.io
        paths: ["/bar/"]
        reason: "project git remote (origin)"
      - host: objects.githubusercontent.com
        reason: "project git remote (origin)"
      # Imported from project settings
      - host: docs.example.com
        methods: [GET]
    deny_always:
      # Read-only git access — block push (git-receive-pack) to project remotes
      - host: github.com
        paths: ["/foo/bar/git-receive-pack", "/foo/bar.git/git-receive-pack"]
        reason: "read-only: push (git-receive-pack) to origin blocked; re-run init with --git-push to allow"
